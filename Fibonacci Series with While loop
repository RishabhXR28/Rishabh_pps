#include <stdio.h>
int main()
{
    int n, i;
    int first=0, second=1, next;
    printf("Enter the term(n) you want in Fibonacci Series:\n");
    scanf("%d", &n);
    
    if (n < 1)
    {
        printf("Please Enter a Natural Number\n");
    }
    else if (n==1)                                                                   
    {
        printf("The %dth term in Fibonacci Series is %d\n", n, first);
    }
    else if (n==2)
    {
        printf("The %dth term in Fibonacci Series is %d\n", n, second);
    }
    else
    {
        i = 3;
        while (i<=n)
        {
            next=first+second;
            first=second;
            second=next;
            i++;
        }
        printf("The %dth term in Fibonacci Series is %d\n", n, next);
    }
    return 0;
}
