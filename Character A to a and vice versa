#include <stdio.h>
int main()
{
    char ch;

    printf("***************************************\n");
    printf("      Case Conversion Program          \n");
    printf("***************************************\n");
    printf("Enter a Character : ");
    scanf(" %c", &ch);

    if(ch >= 'A' && ch <= 'Z')
    {
        printf("You Entered Uppercase : '%c'\n", ch);
        printf("Lowercase of '%c' is  : '%c'\n", ch, ch + 32);
    }
    else if(ch >= 'a' && ch <= 'z')
    {
        printf("You Entered Lowercase : '%c'\n", ch);
        printf("Uppercase of '%c' is  : '%c'\n", ch, ch - 32);
    }
    else
    {
        printf("'%c' is not an Alphabet\n", ch);
    }

    return 0;
}
